{
  "name": "hipno-clinic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite-ssg build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:netlify": "npx netlify-cli dev",
    "deploy": "npx netlify-cli deploy --build --prod",
    "prebuild": "node scripts/generate-blog-data.mjs && node scripts/generate-sitemap.mjs",
    "postbuild": "node scripts/check-contact.mjs && node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@netlify/blobs": "^11.1.9",
    "@netlify/functions": "^6.1.1",
    "@unhead/vue": "^2.1.17",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "pinia": "^4.1.0",
    "sanitize-html": "^2.18.2",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "htmlparser2": "10.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.2",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.3.14"
  }
}
